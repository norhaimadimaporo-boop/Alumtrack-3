# MySQL connection used by the AlumTrack server (server functions).
# Copy this file to .env and fill in your own credentials. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=alumtrack

# Set to true for hosted MySQL providers that require TLS (e.g. PlanetScale).
# DB_SSL=false

# Demo accounts created by `npm run db:setup`. Change these passwords before
# using the app with real data.
SEED_ALUMNI_EMAIL=alumni@alumtrack.test
SEED_ALUMNI_PASSWORD=Alumni2026!
SEED_ADMIN_EMAIL=admin@alumtrack.test
SEED_ADMIN_PASSWORD=Admin2026!
