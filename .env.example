# MySQL connection used by the AlumTrack server (server functions).
# Copy this file to .env and fill in your own credentials. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=alumtrack

# Set to true for hosted MySQL providers that require TLS (e.g. PlanetScale).
# DB_SSL=false

# Max pooled connections per server instance. Keep this small on Vercel (2-5)
# because every serverless instance opens its own pool.
# DB_CONNECTION_LIMIT=10

# Base64 of the provider's CA certificate (ca.pem). Required by Aiven and other
# providers that use a private CA instead of a publicly trusted certificate.
# PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("ca.pem"))
# DB_SSL_CA_BASE64=

# Demo accounts created by `npm run db:setup`. Change these passwords before
# using the app with real data.
SEED_ALUMNI_EMAIL=alumni@alumtrack.test
SEED_ALUMNI_PASSWORD=Alumni2026!
SEED_ADMIN_EMAIL=admin@alumtrack.test
SEED_ADMIN_PASSWORD=Admin2026!

# Vercel Blob store used for post image uploads. Vercel injects this
# automatically when a Blob store is linked to the project; for local
# development run `npx vercel env pull .env.local` (or paste the token here).
# BLOB_READ_WRITE_TOKEN=
